# Copy to .env and adjust. Only DATABASE_URL needs to change to switch backends.

SECRET_KEY=change-me-in-production

# SQLite (default; path is relative to the project's instance/ folder)
DATABASE_URL=sqlite:///instance/events.db

# PostgreSQL -- pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://events:secret@localhost:5432/events

# MySQL / MariaDB -- pip install PyMySQL
# DATABASE_URL=mysql+pymysql://events:secret@localhost:3306/events?charset=utf8mb4

# SQL_ECHO=1

# Public base URL for shareable invite links (set when behind a proxy/domain)
# INVITE_BASE_URL=https://party.example.com

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs            # rotating file lives here (events.log)
# LOG_MAX_BYTES=10485760  # rotate at 10MB
# LOG_BACKUPS=5           # keep this many rotated files

# Reverse proxy: number of trusted proxy hops in front of the app (0 = none).
# Set to 1 behind a single nginx so the app honours X-Forwarded-* — including
# X-Forwarded-Prefix, which lets it be mounted under any sub-path.
# PROXY_FIX_HOPS=1

# Cookie security: Secure is ON by default (HTTPS). Set to 0 only for local
# http testing without FLASK_DEBUG (debug already relaxes it automatically).
# SESSION_COOKIE_SECURE=1

# Email.
# Hard opt-out: set to 0 to guarantee the server NEVER queues or sends any
# email, whatever MAIL_BACKEND says. Default 1 (machinery active).
# MAIL_ENABLED=0
#
# Backend: "console" logs messages (dev default, sends nothing); "smtp" sends.
# MAIL_BACKEND=smtp
# MAIL_DEFAULT_SENDER=Cordially <no-reply@party.example.com>
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=apikey
# MAIL_SMTP_PASSWORD=secret
# MAIL_SMTP_USE_TLS=1        # STARTTLS on 587
# MAIL_SMTP_USE_SSL=0        # implicit TLS on 465
